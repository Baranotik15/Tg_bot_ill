# Telegram bot token from @BotFather
BOT_TOKEN=replace-with-your-telegram-bot-token

# Comma-separated Telegram user IDs with admin rights (e.g., 123456789,987654321)
ADMIN_IDS=

# Initial points granted to new users at /start
INIT_POINTS=1000

# Async SQLAlchemy database URL (aiosqlite for SQLite)
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Where to store rotating logs and hourly dumps
LOG_DIR=./logs
DUMP_DIR=./dumps

# Your website domen
WEB_URL=https://mafbot.org